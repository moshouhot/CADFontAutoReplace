<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>AFR</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Platforms>AnyCPU;x64</Platforms>
    <CadBrand>AutoCAD</CadBrand>
  </PropertyGroup>

  <ItemGroup>
    <CadDescriptor Include="2013">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R19.0</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2014">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R19.1</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2015">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R20.0</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2016">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R20.1</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2017">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R21.0</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2018">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R22.0</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2019">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R23.0</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2020">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R23.1</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2021">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R24.0</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2022">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R24.1</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2023">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R24.2</RegistryBasePath>
    </CadDescriptor>
    <CadDescriptor Include="2024">
      <RegistryBasePath>Software\Autodesk\AutoCAD\R24.3</RegistryBasePath>
    </CadDescriptor>
  </ItemGroup>

  <Import Project="..\..\AFR.Core\AFR.Core.projitems" Label="Shared" />
  <Import Project="..\..\AFR.UI\AFR.UI.projitems" Label="Shared" />
  <Import Project="..\AFR.AutoCAD\AFR.AutoCAD.projitems" Label="Shared" />
  <Import Project="..\..\AFR.Polyfills\AFR.Polyfills.projitems" Label="Shared" />
  <Import Project="..\..\AFR.HostIntegration\AFR.HostIntegration.projitems" Label="Shared" />

  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="24.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
